Terminal = "kitty"
EphemeralTerminal = "pypr-client toggle ephemeral-kitty"
Files = "nautilus"
Menu = "vicinae toggle"
Emojis = "vicinae vicinae://launch/core/search-emojis"
Clipboard = "vicinae vicinae://launch/clipboard/history"
Browser = "brave --profile-directory=Default"
WorkBrowser = "brave --profile-directory=\"Profile 1\""
Whatsapp = "brave --profile-directory=Default --new-window --app=https://web.whatsapp.com"
HomeAssistant = "chromium --new-window --app=https://home.cuasar.cc"
Lock = "pidof gtklock >/dev/null || gtklock -d -f"
ColorPicker = "hyprpicker --autocopy"
Obsidian = "obsidian --disable-gpu --ozone-platform-hint=wayland"

{{ if eq .chezmoi.hostname "arch-desktop" -}}
InitialWorkspace = 6
MainMonitor = 1
{{ else if eq .chezmoi.hostname "arch-laptop" -}}
InitialWorkspace = 1
MainMonitor = 0
{{- end -}}
